{
  "name": "owlid",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "trustedDependencies": [
    "@midnight-ntwrk/compact-runtime",
    "@midnight-ntwrk/midnight-js-level-private-state-provider"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:app": "bun run --filter @owlid/app dev",
    "dev:admin": "bun run --filter @owlid/admin dev",
    "dev:docs": "bun run --filter @owlid/docs-site dev",
    "build": "bun run --filter '*' build",
    "build:app": "bun run --filter @owlid/app build",
    "build:sdk": "bun run --filter @owlid/sdk build",
    "ci:build-libs": "bun run --filter @owlid/config build && bun run --filter @owlid/verifier-client build && bun run --filter @owlid/issuer-client build && bun run --filter @owlid/admin-client build && bun run --filter @owlid/sdk build",
    "ci:typecheck": "bun run --filter @owlid/config --filter @owlid/ui --filter @owlid/verifier-client --filter @owlid/issuer-client --filter @owlid/admin-client --filter @owlid/sdk --filter @owlid/app --filter @owlid/verifier-app --filter @owlid/admin --filter @owlid/docs-site check",
    "build:admin": "bun run --filter @owlid/admin build",
    "build:docs": "bun run --filter @owlid/docs-site build",
    "test": "bun run --filter '*' test",
    "test:sdk": "bun run --filter @owlid/sdk test",
    "check": "bun run --filter '*' check",
    "lint": "oxlint --config oxlint.json .",
    "lint:fix": "oxlint --config oxlint.json --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:toml": "taplo format",
    "format:toml:check": "taplo format --check",
    "typecheck": "bun run --filter '*' check",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/.output packages/*/dist",
    "prepare": "husky"
  },
  "devDependencies": {
    "@slidev/cli": "^52.15.2",
    "@slidev/theme-default": "^0.25.0",
    "@taplo/cli": "^0.7.0",
    "@types/bun": "^1.3.13",
    "binaryen": "^125.0.0",
    "commander": "^14.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.63.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.@(js|ts|tsx|mjs|cjs)": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.@(json|md|yml|yaml)": [
      "prettier --write"
    ],
    "*.toml": [
      "taplo format"
    ]
  },
  "prettier": {
    "printWidth": 100,
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "always",
    "tabWidth": 2,
    "useTabs": false
  },
  "packageManager": "bun@1.3.13",
  "overrides": {
    "@midnight-ntwrk/compact-js": "2.5.0"
  },
  "dependencies": {
    "countries-list": "^3.3.0"
  }
}
