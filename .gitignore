*.log

# Node/Bun - Root
node_modules/
bun.lock

# Packages
packages/*/node_modules/
packages/*/.output/
packages/*/dist/
packages/*/.nuxt/
packages/*/.nitro/
packages/*/.cache/
packages/*/.vinxi/
packages/docs-site/doc_build/

