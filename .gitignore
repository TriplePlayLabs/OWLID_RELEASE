.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment / secrets — keep local only, never commit.
# Catch every variant: .env, .env.local, .env.preview, .env.preprod,
# .env.<anything>, including dotted sub-suffixes like .env.production.local.
# Allow .env.example (committed template) + .env.gcp.example (deploy template).
.env
.env.*
!.env.example
!.env.*.example
accounts.json

# Build artifacts
*.wasm
*.so
*.dylib
*.dll
*.node

# Coverage
coverage/

# Turbo
.turbo/


# midnight
midnight-level-db/
dist/

# Compact compiler output (regenerated by `bun run compact` in sidecar)
packages/midnight-sidecar/managed/

# Terraform / GCP deploy
deploy/gcp/.env.gcp
deploy/gcp/terraform/.terraform/
deploy/gcp/terraform/.terraform.lock.hcl
# terraform.tfvars IS tracked: it holds no credentials (every secret is a
# Secret Manager reference in run.tf) and it carries the deployed contract
# addresses, which are public on-chain data and otherwise recoverable only
# by reading them back out of Cloud Run.
deploy/gcp/terraform/*.tfstate
deploy/gcp/terraform/*.tfstate.*
deploy/gcp/terraform/.terraform.tfstate.lock.info

packages/*/.tanstack/

# Local plugin state (midnight-expert hook bookkeeping)
.midnight-expert/

# Claude Code local/transient state
.claude/scheduled_tasks.lock
.claude/settings.local.json
