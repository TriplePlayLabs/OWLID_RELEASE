# Multi-stage Docker build for OwlID Issuer Service

# Stage 1: Builder
FROM rust:1.91-slim as builder

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

# Build the issuer service in release mode
RUN cargo build --release -p owl-issuer-service

# Stage 2: Runtime
FROM debian:trixie-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3t64 \
    && rm -rf /var/lib/apt/lists/*

# Copy the binary from builder
COPY --from=builder /app/target/release/owl-issuer-service /app/owl-issuer-service

# Expose port
EXPOSE 8001

# Set environment variables
ENV RUST_LOG=info

# Run the service
CMD ["/app/owl-issuer-service"]
