# Multi-stage build for OwlID docs site (rspress static).
#
# Pure rspress build. No native-sdk, no workspace JS deps beyond docs-site
# itself. Stub other workspaces so bun install doesn't recurse.

FROM oven/bun:1.3.14 AS builder
WORKDIR /app

COPY package.json bun.lock* bunfig.toml ./

# Workspace stubs under real `@owlid/...` names so bun install doesn't fail
# on workspace:* entries from packages we don't ship in this image.
RUN for pkg in app admin verifier-app sdk config ui midnight-sidecar \
                verifier-client issuer-client admin-client; do \
        mkdir -p "packages/$pkg" \
        && printf '{"name":"@owlid/%s","version":"0.0.0","private":true}\n' "$pkg" \
            > "packages/$pkg/package.json"; \
    done

# Real docs-site source
COPY packages/docs-site/package.json packages/docs-site/

RUN bun install

COPY packages/docs-site packages/docs-site

# rspress build (uses prebuild hook to sync content from /docs).
COPY docs ./docs
COPY README.md ./README.md
RUN cd packages/docs-site && bun run build

FROM nginx:alpine
COPY --from=builder /app/packages/docs-site/doc_build /usr/share/nginx/html
COPY docker/nginx-spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
