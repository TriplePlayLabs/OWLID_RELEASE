project_id        = "owlid-491411"
region            = "europe-west1"
billing_account   = "000000-000000-000000"
budget_amount_eur = 300
domain            = "owlid.app"
dns_zone_name     = "owlid-app"

# image_tag = "latest"
# use_placeholder_images = true   # set to true on the first apply if images aren't built yet

# --- Runtime mode -----------------------------------------------------------
# 'development' is correct for .run.app deploy (Cloud Run hostnames are on
# the Public Suffix List so cross-service cookies aren't possible there).
# Flip to 'production' after wiring the custom domain.
app_env = "development"

# Apex domain for the verification admin cookie. Leave empty until a custom
# domain is ACTIVE and frontends are mapped to subdomains.
# When set: e.g. "owlid.app" -> cookie scope spans api/admin/app/verifier subdomains.
admin_cookie_domain = ""

# Extra CORS origins on top of the predictable frontend Cloud Run URLs.
# Add custom-domain origins here once the domain is mapped:
# extra_cors_origins = ["https://app.owlid.app", "https://admin.owlid.app", "https://verifier.owlid.app"]
extra_cors_origins = []

# Midnight wiring (off until real chain endpoints are configured).
midnight_auto_register_issuer = false
midnight_sidecar_timeout_ms   = 30000

# --- Midnight network -------------------------------------------------------
# Switch the whole Cloud Run stack between networks by changing these vars.
# Contract addresses are PUBLIC (on-chain) — safe to commit. Secrets live in
# Secret Manager (mnemonic, sidecar API key, etc), never in tfvars.
#
# Local devnet (default):
#   midnight_network_id    = "undeployed"
#   wallet_source          = "seed"        # uses devnet genesis seed
#
# Midnight Preview testnet:
#   midnight_network_id      = "preview"
#   midnight_node_ws_url     = "wss://rpc.preview.midnight.network"
#   midnight_indexer_uri     = "https://indexer.preview.midnight.network/api/v4/graphql"
#   midnight_indexer_ws_uri  = "wss://indexer.preview.midnight.network/api/v4/graphql/ws"
#   midnight_proof_server_uri = "https://proof-server.preview.midnight.network"
#   wallet_source            = "mnemonic"  # populate midnight-wallet-mnemonic
#                                          # secret via gcloud before applying
#   midnight_issuer_registry_address       = "<paste from `bun run deploy` output>"
#   midnight_revocation_registry_address   = "..."
#   midnight_identity_registry_address     = "..."
#   midnight_predicate_age_address         = "..."
#   midnight_predicate_kyc_address         = "..."
#   midnight_predicate_residency_address   = "..."
#   midnight_predicate_email_address       = "..."
#   midnight_predicate_nationality_address = "..."
#   midnight_predicate_age_range_address   = "..."
#   midnight_predicate_personhood_address  = "..."
midnight_network_id  = "undeployed"
wallet_source        = "seed"
