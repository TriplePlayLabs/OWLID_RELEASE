# Native SDK builder — produces a populated packages/native-sdk/ directory
# (Linux .node + browser WASM + JS bindings) ready to be COPY'd into frontend
# build stages via `--from=native-sdk-builder`.
#
# Mirrors the napi/wasm-opt steps from `just build-sdk` exactly.
#
# Output paths (under / in the final image):
#   /native-sdk/owl-id.linux-x64-gnu.node
#   /native-sdk/owl-id.wasm32-wasi.wasm
#   /native-sdk/owl-id.wasi-browser.js
#   /native-sdk/owl-id.wasi.cjs
#   /native-sdk/wasi-worker.mjs
#   /native-sdk/wasi-worker-browser.mjs
#   /native-sdk/npm/linux-x64-gnu/index.node
#   /native-sdk/npm/wasm32-wasi/owl-id.wasm32-wasi.wasm
#   /native-sdk/npm/wasm32-wasi/owl-id.wasi*.{cjs,js}
#   /native-sdk/{index.js,index.mjs,index.d.ts,browser.js,package.json,...}

FROM rust:1.91-slim AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl pkg-config libssl-dev clang \
        unzip xz-utils gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Bun (matches host workflow)
RUN curl -fsSL https://bun.sh/install | bash \
    && ln -s /root/.bun/bin/bun /usr/local/bin/bun \
    && ln -s /root/.bun/bin/bunx /usr/local/bin/bunx

# WASM target for napi
RUN rustup target add wasm32-wasip1-threads

# wasi-sdk — provides clang + sysroot + libc for wasm32-wasi targets so
# cc-rs (used by zstd-sys etc.) can compile C deps when building the
# wasm32-wasip1-threads target.
ENV WASI_SDK_VERSION=25
ENV WASI_SDK_PATH=/opt/wasi-sdk
RUN curl -fsSL "https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-${WASI_SDK_VERSION}/wasi-sdk-${WASI_SDK_VERSION}.0-x86_64-linux.tar.gz" \
    | tar -xz -C /opt \
    && mv "/opt/wasi-sdk-${WASI_SDK_VERSION}.0-x86_64-linux" "$WASI_SDK_PATH"

# Point cc-rs at the wasi-sdk toolchain when building the wasm target.
ENV CC_wasm32_wasip1_threads=/opt/wasi-sdk/bin/clang
ENV CXX_wasm32_wasip1_threads=/opt/wasi-sdk/bin/clang++
ENV AR_wasm32_wasip1_threads=/opt/wasi-sdk/bin/llvm-ar
ENV CFLAGS_wasm32_wasip1_threads="--target=wasm32-wasi-threads --sysroot=/opt/wasi-sdk/share/wasi-sysroot -pthread"

WORKDIR /app

# Workspace root + native-sdk + Rust crates that native-sdk depends on.
COPY package.json bun.lock* ./
COPY packages/native-sdk/package.json packages/native-sdk/

# Workspace stub package.jsons under the real `@owlid/...` names. Required
# for bun install to traverse the workspace; we don't actually need their
# source here.
RUN for pkg in app admin verifier-app docs-site midnight-sidecar ui \
                sdk config verifier-client issuer-client admin-client; do \
        mkdir -p "packages/$pkg" \
        && printf '{"name":"@owlid/%s","version":"0.0.0","private":true}\n' "$pkg" \
            > "packages/$pkg/package.json"; \
    done \
    && mkdir -p packages/native-sdk/npm/wasm32-wasi packages/native-sdk/npm/linux-x64-gnu \
    && printf '{"name":"@owlid/native-sdk-wasm32-wasi","version":"1.0.0","main":"owl-id.wasi.cjs","browser":"owl-id.wasi-browser.js"}\n' \
        > packages/native-sdk/npm/wasm32-wasi/package.json \
    && printf '{"name":"@owlid/native-sdk-linux-x64-gnu","version":"1.0.0","main":"index.node"}\n' \
        > packages/native-sdk/npm/linux-x64-gnu/package.json

RUN bun install

# Real sources: native-sdk itself + the Rust crates it links to.
# Host's packages/native-sdk/npm/ is excluded by .dockerignore (binaries are
# generated below), so the stub package.json files written above survive.
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY packages/native-sdk packages/native-sdk

# Generate Groth16 proving keys (deterministic dev seeds). Mirrors
# `just generate-zk-keys`. Required: native-sdk's owl-zk-circuits dep
# enables `prover-keys-embedded` which `include_bytes!` these files at
# compile time. They are .gitignore'd so we always regenerate inside the
# image to keep the build self-contained.
# `--no-default-features` is critical — otherwise the lib tries to
# include_bytes! the very files we're about to write.
RUN cargo run -p owl-zk-circuits --bin keygen --no-default-features --release

# Mirrors `just build-sdk` (justfile :219).
RUN cd packages/native-sdk \
    && rm -f *.wasm npm/wasm32-wasi/*.wasm 2>/dev/null || true \
    && bunx napi build --platform --release \
    && RUSTFLAGS='-C target-feature=-extended-const,-multivalue,-reference-types,-relaxed-simd,-tail-call,-wide-arithmetic' \
       bunx napi build --platform --target wasm32-wasip1-threads --release \
    && bunx napi artifacts -o . --npm-dir npm \
    && ../../node_modules/binaryen/bin/wasm-opt \
        npm/wasm32-wasi/owl-id.wasm32-wasi.wasm \
        --enable-threads --enable-bulk-memory --enable-mutable-globals \
        --enable-sign-ext --enable-nontrapping-float-to-int \
        -O2 -o npm/wasm32-wasi/owl-id.wasm32-wasi.wasm

# Final image: only the populated native-sdk tree. Frontend Dockerfiles
# pull this in via `COPY --from=native-sdk-builder /native-sdk ...` and
# build the TS sdk + clients + their own app themselves.
FROM scratch
COPY --from=builder /app/packages/native-sdk /native-sdk
