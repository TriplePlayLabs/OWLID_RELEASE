{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-var": "error",
    "prefer-const": "error",
    "no-debugger": "warn"
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".output",
    "target",
    "test-results",
    "playwright-report",
    "**/e2e/fixtures/**",
    "*.gen.ts",
    "*.d.ts",
    "**/midnight/contracts/**/index.js"
  ],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.spec.ts", "__test__/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
