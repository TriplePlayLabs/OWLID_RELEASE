// OwlID predicate contract — kyc level >= public threshold.
// Attestation key recipe matches `owl_proof_system::attestation::kyc_key`.
//
// The witness kycLevel is bound to the issuer-signed credential: its claim
// commitment persistentHash([pad32("kycLevel"), level, salt]) must be a leaf
// under the issuer-signed owl_root (the public arg). Without this a holder
// could attest any level from a fabricated witness.

pragma language_version >= 0.23;

import CompactStandardLibrary;
import "./lib/access/Ownable" prefix Ownable_;
import "./lib/security/Pausable" prefix Pausable_;

export { ZswapCoinPublicKey, ContractAddress, Either, Maybe };

// The issuer-committed kyc level.
witness kycLevel(): Uint<8>;
// The per-claim salt (sha256 of the SD-JWT disclosure salt) used in the
// issuer's claim commitment.
witness claimSalt(): Bytes<32>;
// Merkle inclusion proof of this claim's commitment under owl_root.
witness claimPath(): MerkleTreePath<8, Bytes<32>>;

export ledger attestations: Set<Bytes<32>>;
export ledger attestTree: HistoricMerkleTree<32, Bytes<32>>;
export ledger attestCount: Counter;

constructor(initialOwner: Either<ZswapCoinPublicKey, ContractAddress>) {
  Ownable_initialize(initialOwner);
}

circuit keyOf(tag: Bytes<32>, dRootHash: Bytes<32>, dParam: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([tag, dRootHash, dParam]);
}

circuit record(key: Bytes<32>): [] {
  if (!attestations.member(key)) {
    attestations.insert(key);
    attestTree.insert(key);
    attestCount.increment(1);
  }
}

export circuit attestKycGte(owlRoot: Bytes<32>, threshold: Uint<8>): [] {
  Pausable_assertNotPaused();
  assert(owlRoot != pad(32, "") as Bytes<32>, "zero owlRoot");

  const lvl  = kycLevel();
  const salt = claimSalt();
  const path = claimPath();

  // Bind the level to the issuer: its commitment must be a leaf under the
  // issuer-signed owl_root, so a fabricated witness has no valid path.
  const leaf = persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "verification_level"), lvl as Field as Bytes<32>, salt]
  );
  assert(path.leaf == leaf, "claim commitment != kycLevel witness");
  const root = merkleTreePathRoot<8, Bytes<32>>(path);
  assert(owlRoot == disclose(root.field) as Bytes<32>, "owl_root mismatch");

  assert(lvl >= threshold, "kyc below threshold");
  record(keyOf(
    pad(32, "owlid:attest:kyc:"),
    disclose(owlRoot),
    disclose(threshold) as Field as Bytes<32>
  ));
}

export circuit isAttested(key: Bytes<32>): Boolean {
  return attestations.member(disclose(key));
}

export circuit pause(): [] { Ownable_assertOnlyOwner(); Pausable__pause(); }
export circuit unpause(): [] { Ownable_assertOnlyOwner(); Pausable__unpause(); }
export circuit transferOwnership(newOwner: Either<ZswapCoinPublicKey, ContractAddress>): [] {
  Ownable_transferOwnership(newOwner);
}
export circuit owner(): Either<ZswapCoinPublicKey, ContractAddress> { return Ownable_owner(); }
export circuit isPaused(): Boolean { return Pausable_isPaused(); }
