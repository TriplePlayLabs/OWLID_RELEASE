// OwlID Identity Registry — Compact contract for Midnight.
// Anchors DIDs and credential commitments on-chain.
// Privacy-preserving: only cryptographic commitments stored, never raw PII.
//
// Membership of a commitment in the registry is tracked via a
// `Set<Bytes<32>>` (`registeredCommitments`). Off-chain Merkle proofs
// over commitments are produced by OwlID's Rust core (crates/crypto).
//
// Owner / pause / initialization inherited from vendored OZ stdlib
// (contracts/lib).

pragma language_version >= 0.23;

import CompactStandardLibrary;
import "./lib/access/Ownable" prefix Ownable_;
import "./lib/security/Pausable" prefix Pausable_;
import "./lib/security/Initializable" prefix Initializable_;

export { ZswapCoinPublicKey, ContractAddress, Either, Maybe };

export enum CommitmentStatus {
  INACTIVE,
  ACTIVE,
  EXPIRED
}

export ledger commitments: Map<Bytes<32>, Bytes<32>>;
export ledger commitmentStatuses: Map<Bytes<32>, CommitmentStatus>;
export ledger commitmentIssuers: Map<Bytes<32>, Bytes<32>>;
export ledger didOwners: Map<Bytes<32>, Bytes<32>>;
export ledger registeredCommitments: Set<Bytes<32>>;
export ledger identityCount: Counter;

witness ownerSecretKey(): Bytes<32>;

constructor(initialOwner: Either<ZswapCoinPublicKey, ContractAddress>) {
  Ownable_initialize(initialOwner);
}

// Domain-separated derivation of an owner-pubkey-hash from a secret key.
circuit deriveOwnerHash(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "owlid:did:owner:"), sk]);
}

export circuit registerIdentity(
  didHash: Bytes<32>,
  commitment: Bytes<32>,
  issuerKeyHash: Bytes<32>
): [] {
  Pausable_assertNotPaused();

  assert(didHash != pad(32, "") as Bytes<32>, "Invalid zero DID hash");
  assert(commitment != pad(32, "") as Bytes<32>, "Invalid zero commitment");
  assert(issuerKeyHash != pad(32, "") as Bytes<32>, "Invalid zero issuer hash");

  const dDidHash = disclose(didHash);
  if (commitmentStatuses.member(dDidHash)) {
    assert(
      commitmentStatuses.lookup(dDidHash) != CommitmentStatus.ACTIVE,
      "DID already has active commitment"
    );
  }

  const sk = ownerSecretKey();
  const ownerHash = deriveOwnerHash(sk);

  commitments.insert(dDidHash, disclose(commitment));
  commitmentStatuses.insert(dDidHash, disclose(CommitmentStatus.ACTIVE));
  commitmentIssuers.insert(dDidHash, disclose(issuerKeyHash));
  didOwners.insert(dDidHash, disclose(ownerHash));

  const dCommitment = disclose(commitment);
  if (!registeredCommitments.member(dCommitment)) {
    registeredCommitments.insert(dCommitment);
  }
  identityCount.increment(1);
}

export circuit updateCommitment(
  didHash: Bytes<32>,
  newCommitment: Bytes<32>,
  issuerKeyHash: Bytes<32>
): [] {
  Pausable_assertNotPaused();

  assert(newCommitment != pad(32, "") as Bytes<32>, "Invalid zero commitment");

  const dDidHash = disclose(didHash);
  assert(commitments.member(dDidHash), "DID not found");
  assert(
    commitmentStatuses.lookup(dDidHash) == CommitmentStatus.ACTIVE,
    "Commitment not active"
  );

  const sk = ownerSecretKey();
  const ownerHash = deriveOwnerHash(sk);
  assert(didOwners.lookup(dDidHash) == ownerHash, "Not the DID owner");

  const dNewCommitment = disclose(newCommitment);
  commitments.insert(dDidHash, dNewCommitment);
  commitmentIssuers.insert(dDidHash, disclose(issuerKeyHash));

  if (!registeredCommitments.member(dNewCommitment)) {
    registeredCommitments.insert(dNewCommitment);
  }
}

export circuit adminUpdateCommitment(
  didHash: Bytes<32>,
  newCommitment: Bytes<32>,
  issuerKeyHash: Bytes<32>
): [] {
  Ownable_assertOnlyOwner();

  const dDidHash = disclose(didHash);
  assert(commitments.member(dDidHash), "DID not found");

  const dNewCommitment = disclose(newCommitment);
  commitments.insert(dDidHash, dNewCommitment);
  commitmentStatuses.insert(dDidHash, disclose(CommitmentStatus.ACTIVE));
  commitmentIssuers.insert(dDidHash, disclose(issuerKeyHash));

  if (!registeredCommitments.member(dNewCommitment)) {
    registeredCommitments.insert(dNewCommitment);
  }
}

export circuit isCommitmentRegistered(commitment: Bytes<32>): Boolean {
  return registeredCommitments.member(disclose(commitment));
}

export circuit getCommitment(didHash: Bytes<32>): Bytes<32> {
  const dDidHash = disclose(didHash);
  assert(commitments.member(dDidHash), "DID not found");
  return commitments.lookup(dDidHash);
}

export circuit getCommitmentStatus(didHash: Bytes<32>): CommitmentStatus {
  const dDidHash = disclose(didHash);
  if (!commitmentStatuses.member(dDidHash)) {
    return CommitmentStatus.INACTIVE;
  }
  return commitmentStatuses.lookup(dDidHash);
}

export circuit getCommitmentIssuer(didHash: Bytes<32>): Bytes<32> {
  const dDidHash = disclose(didHash);
  assert(commitmentIssuers.member(dDidHash), "DID not found");
  return commitmentIssuers.lookup(dDidHash);
}

export circuit expireCommitment(didHash: Bytes<32>): [] {
  Ownable_assertOnlyOwner();
  const dDidHash = disclose(didHash);
  assert(commitments.member(dDidHash), "DID not found");
  assert(
    commitmentStatuses.lookup(dDidHash) == CommitmentStatus.ACTIVE,
    "Commitment not active"
  );
  commitmentStatuses.insert(dDidHash, disclose(CommitmentStatus.EXPIRED));
}

export circuit pause(): [] {
  Ownable_assertOnlyOwner();
  Pausable__pause();
}

export circuit unpause(): [] {
  Ownable_assertOnlyOwner();
  Pausable__unpause();
}

export circuit transferOwnership(newOwner: Either<ZswapCoinPublicKey, ContractAddress>): [] {
  Ownable_transferOwnership(newOwner);
}

export circuit owner(): Either<ZswapCoinPublicKey, ContractAddress> {
  return Ownable_owner();
}

export circuit isPaused(): Boolean {
  return Pausable_isPaused();
}
