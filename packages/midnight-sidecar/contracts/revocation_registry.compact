// OwlID Revocation Registry — Compact contract for Midnight.
// Tracks credential revocation status on-chain.
//
// State layers:
//   - credentialStatuses / credentialIssuers / credentialReasons: live lookup
//     by Merkle-root hash, supports reactivate (Map can be overwritten).
//   - revokedCredentials (Set): current revocations only, supports remove
//     on reactivate — fast membership for verifiers.
//   - revokedTree (HistoricMerkleTree): append-only audit log of every
//     revocation event, enables chain-anchored inclusion proofs and is
//     immutable across reactivations.
//
// Owner / pause / initialization inherited from vendored OZ stdlib
// (contracts/lib).

pragma language_version >= 0.23;

import CompactStandardLibrary;
import "./lib/access/Ownable" prefix Ownable_;
import "./lib/security/Pausable" prefix Pausable_;
import "./lib/security/Initializable" prefix Initializable_;

export { ZswapCoinPublicKey, ContractAddress, Either, Maybe };

export enum CredentialStatus {
  ACTIVE,
  REVOKED,
  SUSPENDED
}

export ledger credentialStatuses: Map<Bytes<32>, CredentialStatus>;
export ledger credentialIssuers: Map<Bytes<32>, Bytes<32>>;
export ledger credentialReasons: Map<Bytes<32>, Opaque<"string">>;
export ledger revokedCredentials: Set<Bytes<32>>;
export ledger revokedTree: HistoricMerkleTree<32, Bytes<32>>;
export ledger revocationCount: Counter;

// Witness: caller-supplied Merkle path to a previously-revoked rootHash.
// Used by `proveRevocationInclusion` to demonstrate cryptographic
// inclusion against a historic tree root.
witness revocationPath(rootHash: Bytes<32>): MerkleTreePath<32, Bytes<32>>;

constructor(initialOwner: Either<ZswapCoinPublicKey, ContractAddress>) {
  Ownable_initialize(initialOwner);
}

export circuit revoke(rootHash: Bytes<32>, issuerKeyHash: Bytes<32>, reason: Opaque<"string">): [] {
  Ownable_assertOnlyOwner();
  Pausable_assertNotPaused();

  assert(rootHash != pad(32, "") as Bytes<32>, "Invalid zero root hash");

  const dRootHash = disclose(rootHash);

  if (credentialStatuses.member(dRootHash)) {
    assert(
      credentialStatuses.lookup(dRootHash) != CredentialStatus.REVOKED,
      "Credential already revoked"
    );
  }

  credentialStatuses.insert(dRootHash, disclose(CredentialStatus.REVOKED));
  credentialIssuers.insert(dRootHash, disclose(issuerKeyHash));
  credentialReasons.insert(dRootHash, disclose(reason));

  if (!revokedCredentials.member(dRootHash)) {
    revokedCredentials.insert(dRootHash);
  }
  revokedTree.insert(dRootHash);
  revocationCount.increment(1);
}

export circuit suspend(rootHash: Bytes<32>, issuerKeyHash: Bytes<32>, reason: Opaque<"string">): [] {
  Ownable_assertOnlyOwner();
  Pausable_assertNotPaused();

  assert(rootHash != pad(32, "") as Bytes<32>, "Invalid zero root hash");

  const dRootHash = disclose(rootHash);

  if (credentialStatuses.member(dRootHash)) {
    const current = credentialStatuses.lookup(dRootHash);
    assert(current != CredentialStatus.REVOKED, "Cannot suspend a revoked credential");
    assert(current != CredentialStatus.SUSPENDED, "Credential already suspended");
  }

  credentialStatuses.insert(dRootHash, disclose(CredentialStatus.SUSPENDED));
  credentialIssuers.insert(dRootHash, disclose(issuerKeyHash));
  credentialReasons.insert(dRootHash, disclose(reason));

  if (!revokedCredentials.member(dRootHash)) {
    revokedCredentials.insert(dRootHash);
  }
  revokedTree.insert(dRootHash);
  revocationCount.increment(1);
}

export circuit reactivate(rootHash: Bytes<32>, issuerKeyHash: Bytes<32>): [] {
  Ownable_assertOnlyOwner();
  Pausable_assertNotPaused();

  const dRootHash = disclose(rootHash);

  assert(credentialStatuses.member(dRootHash), "Credential not found");
  assert(
    credentialStatuses.lookup(dRootHash) == CredentialStatus.SUSPENDED,
    "Only suspended credentials can be reactivated"
  );
  assert(
    credentialIssuers.lookup(dRootHash) == disclose(issuerKeyHash),
    "Issuer mismatch"
  );

  credentialStatuses.insert(dRootHash, disclose(CredentialStatus.ACTIVE));
  credentialReasons.remove(dRootHash);
  revokedCredentials.remove(dRootHash);
  // revokedTree is intentionally append-only (historical audit trail).
}

export circuit isRevoked(rootHash: Bytes<32>): Boolean {
  const dRootHash = disclose(rootHash);
  if (!credentialStatuses.member(dRootHash)) {
    return false;
  }
  const status = credentialStatuses.lookup(dRootHash);
  return status == CredentialStatus.REVOKED || status == CredentialStatus.SUSPENDED;
}

export circuit getStatus(rootHash: Bytes<32>): CredentialStatus {
  const dRootHash = disclose(rootHash);
  if (!credentialStatuses.member(dRootHash)) {
    return CredentialStatus.ACTIVE;
  }
  return credentialStatuses.lookup(dRootHash);
}

export circuit getIssuer(rootHash: Bytes<32>): Bytes<32> {
  const dRootHash = disclose(rootHash);
  assert(credentialIssuers.member(dRootHash), "Credential not found");
  return credentialIssuers.lookup(dRootHash);
}

// Cryptographic inclusion proof: caller supplies a Merkle path via the
// `revocationPath` witness, contract verifies the derived root has been
// historically present in `revokedTree`. Useful when a verifier wants
// chain-anchored evidence (not just trust the operator's lookup) that
// a credential was revoked at some point.
export circuit proveRevocationInclusion(rootHash: Bytes<32>): [] {
  const path = revocationPath(rootHash);
  assert(
    revokedTree.checkRoot(disclose(merkleTreePathRoot<32, Bytes<32>>(path))) &&
      disclose(rootHash) == path.leaf,
    "revocation not in historic tree"
  );
}

export circuit pause(): [] {
  Ownable_assertOnlyOwner();
  Pausable__pause();
}

export circuit unpause(): [] {
  Ownable_assertOnlyOwner();
  Pausable__unpause();
}

export circuit transferOwnership(newOwner: Either<ZswapCoinPublicKey, ContractAddress>): [] {
  Ownable_transferOwnership(newOwner);
}

export circuit owner(): Either<ZswapCoinPublicKey, ContractAddress> {
  return Ownable_owner();
}

export circuit isPaused(): Boolean {
  return Pausable_isPaused();
}
