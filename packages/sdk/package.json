{
  "name": "@owlid/sdk",
  "version": "1.0.0",
  "description": "OwlID SDK - Complete identity SDK with WebAuthn, cryptography, and native bindings",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./verifier": {
      "types": "./dist/verifier.d.ts",
      "import": "./dist/verifier.js"
    },
    "./issuer": {
      "types": "./dist/issuer.d.ts",
      "import": "./dist/issuer.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@owlid/config": "workspace:*",
    "@owlid/issuer-client": "workspace:*",
    "@owlid/native-sdk": "workspace:*",
    "@owlid/verifier-client": "workspace:*",
    "cbor-x": "^1.6.4"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlid/owlid.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "webauthn",
    "passkey",
    "identity",
    "cryptography",
    "cbor",
    "cose",
    "ed25519",
    "p256"
  ]
}
