{
  "name": "@owlid/native-sdk",
  "version": "1.0.0",
  "description": "OwlID Native SDK - Cryptographic identity primitives (Rust/WASM)",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "browser": "browser.js",
  "exports": {
    ".": {
      "browser": "./browser.js",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlid/owlid.git",
    "directory": "packages/native-sdk"
  },
  "license": "MIT",
  "keywords": [
    "napi-rs",
    "NAPI",
    "N-API",
    "Rust",
    "node-addon",
    "identity",
    "cryptography",
    "ed25519",
    "webauthn"
  ],
  "files": [
    "index.d.ts",
    "index.js",
    "index.mjs",
    "browser.js",
    "owl-id.wasi-browser.js",
    "owl-id.wasi.cjs",
    "wasi-worker-browser.mjs",
    "wasi-worker.mjs"
  ],
  "napi": {
    "binaryName": "owl-id",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "i686-pc-windows-msvc",
      "armv7-unknown-linux-gnueabihf",
      "aarch64-apple-darwin",
      "aarch64-linux-android",
      "x86_64-unknown-freebsd",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "armv7-linux-androideabi",
      "wasm32-wasip1-threads"
    ],
    "wasm": {
      "browser": {
        "asyncInit": true,
        "fs": false
      }
    }
  },
  "engines": {
    "node": ">= 18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts -d ../../artifacts",
    "bench": "node --import @oxc-node/core/register benchmark/bench.ts",
    "build": "napi build --platform --release && RUSTFLAGS='-C target-feature=-extended-const,-multivalue,-reference-types,-relaxed-simd,-tail-call,-wide-arithmetic' napi build --platform --target wasm32-wasip1-threads --release && napi artifacts -o . --npm-dir npm && ../../node_modules/binaryen/bin/wasm-opt npm/wasm32-wasi/owl-id.wasm32-wasi.wasm --enable-threads --enable-bulk-memory --enable-mutable-globals --enable-sign-ext --enable-nontrapping-float-to-int -O2 -o npm/wasm32-wasi/owl-id.wasm32-wasi.wasm",
    "build:debug": "napi build --platform && napi artifacts -o . --npm-dir npm",
    "build:wasm": "RUSTFLAGS='-C target-feature=-extended-const,-multivalue,-reference-types,-relaxed-simd,-tail-call,-wide-arithmetic' napi build --platform --target wasm32-wasip1-threads --release && napi artifacts -o . --npm-dir npm && ../../node_modules/binaryen/bin/wasm-opt npm/wasm32-wasi/owl-id.wasm32-wasi.wasm --enable-threads --enable-bulk-memory --enable-mutable-globals --enable-sign-ext --enable-nontrapping-float-to-int -O2 -o npm/wasm32-wasi/owl-id.wasm32-wasi.wasm",
    "build:native": "napi build --platform --release && napi artifacts -o . --npm-dir npm",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "bun test",
    "test:browser": "bun run __test__/serve.ts",
    "preversion": "napi build --platform && git add .",
    "version": "napi version",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@napi-rs/cli": "^3.6.2",
    "@oxc-node/core": "^0.0.35",
    "@tybys/wasm-util": "^0.10.2",
    "binaryen": "^125.0.0",
    "chalk": "^5.6.2",
    "tinybench": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@napi-rs/wasm-runtime": "^1.1.4"
  },
  "optionalDependencies": {
    "@owlid/native-sdk-android-arm-eabi": "1.0.0",
    "@owlid/native-sdk-android-arm64": "1.0.0",
    "@owlid/native-sdk-darwin-arm64": "1.0.0",
    "@owlid/native-sdk-darwin-x64": "1.0.0",
    "@owlid/native-sdk-freebsd-x64": "1.0.0",
    "@owlid/native-sdk-linux-arm-gnueabihf": "1.0.0",
    "@owlid/native-sdk-linux-arm64-gnu": "1.0.0",
    "@owlid/native-sdk-linux-arm64-musl": "1.0.0",
    "@owlid/native-sdk-linux-x64-gnu": "1.0.0",
    "@owlid/native-sdk-linux-x64-musl": "1.0.0",
    "@owlid/native-sdk-wasm32-wasi": "file:npm/wasm32-wasi",
    "@owlid/native-sdk-win32-arm64-msvc": "1.0.0",
    "@owlid/native-sdk-win32-ia32-msvc": "1.0.0",
    "@owlid/native-sdk-win32-x64-msvc": "1.0.0"
  }
}
