{
  "name": "@owlid/admin-client",
  "version": "1.0.0",
  "description": "OwlID Admin API client — operator-only endpoints (admin auth, API keys, GDPR, manage-issuers, manage-revocations, monitoring, internal polling, callbacks). NOT for customer apps.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@owlid/config": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "private": true
}
