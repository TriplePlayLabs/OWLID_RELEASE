# Multi-stage Docker build for OwlID Verification Service

# Stage 1: Builder
FROM rust:1.91-slim as builder

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

# Generate Groth16 proving + verifying keys (deterministic dev seeds).
# Required because owl-zk-circuits' default features embed the .bin files
# via include_bytes! at compile time. `--no-default-features` avoids the
# circular dependency where the lib wants to embed files we're about to
# write. Mirrors `just generate-zk-keys`.
RUN cargo run -p owl-zk-circuits --bin keygen --no-default-features --release

# Build the verification service in release mode
RUN cargo build --release -p owl-verification-service

# Stage 2: Runtime
FROM debian:trixie-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3t64 \
    && rm -rf /var/lib/apt/lists/*

# Copy the binary from builder
COPY --from=builder /app/target/release/owl-verification-service /app/owl-verification-service

# Expose port
EXPOSE 8000

# Set environment variables
ENV RUST_LOG=info

# Run the service
CMD ["/app/owl-verification-service"]
